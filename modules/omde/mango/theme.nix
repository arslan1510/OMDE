{
  flake.modules.homeManager.omde =
    {
      config,
      lib,
      pkgs,
      ...
    }:
    let
      cfg = config.omde;
      theme = cfg.theme;
      palette = theme.palette;
      font = size: ''"${theme.font.family} ${toString size}"'';
      role = name: alpha: "0x${theme.raw.${name}}${alpha}";
      base = slot: "0x${palette.${slot}}ff";
      duration = role: toString theme.motion.${role}.duration;
      curve = role: builtins.toJSON theme.motion.${role}.curve;

      # Shared look for Mango's drawn bars and labels.
      decorate = prefix: size: ''
        ${prefix}_decorate_fg_color = ${role "foreground" "ff"}
        ${prefix}_decorate_bg_color = ${role "background" "ff"}
        ${prefix}_decorate_focus_fg_color = ${role "background" "ff"}
        ${prefix}_decorate_focus_bg_color = ${role "accent" "ff"}
        ${prefix}_decorate_border_color = ${role "muted" "ff"}
        ${prefix}_decorate_border_width = ${toString theme.borderWidth}
        ${prefix}_decorate_corner_radius = ${toString theme.radius}
        ${prefix}_decorate_font_desc = ${font size}
      '';

      themeToml = pkgs.writeText "mango-theme.toml" ''
        # Generated by Home Manager from Stylix; edit the Nix config, not this file.
        [global]
        border_radius = ${toString theme.radius}
        border_px = ${toString theme.borderWidth}

        root_color = ${role "background" "ff"}
        border_color = ${role "muted" "55"}
        focus_color = ${role "accent" "ff"}
        urgent_color = ${role "critical" "ff"}
        drop_color = ${role "accent" "55"}
        split_color = ${role "warning" "ff"}

        maximized_screen_color = ${base "base0C"}
        scratchpad_color = ${base "base0D"}
        global_color = ${base "base0A"}
        overlay_color = ${base "base09"}

        cursor_theme = "${config.stylix.cursor.name or "volantes_cursors"}"
        cursor_size = ${toString (config.stylix.cursor.size or 20)}

        # Motion roles, shared with Quickshell: windows zoom in and out (enter,
        # exit), tags slide (move), focus fades the border and dim (effect). Layers
        # only fade, on Mango's window timings.
        animations = 1
        layer_animations = 1
        animation_type_open = "zoom"
        animation_type_close = "zoom"
        zoom_initial_ratio = ${toString theme.windows.openZoom}
        zoom_end_ratio = ${toString theme.windows.closeZoom}
        layer_animation_type_open = "fade"
        layer_animation_type_close = "fade"
        animation_fade_in = 1
        animation_fade_out = 1
        fade_in_begin_opacity = 0.0
        fade_out_begin_opacity = 1.0
        tag_animation_direction = 1
        animation_duration_open = ${duration "enter"}
        animation_curve_open = ${curve "enter"}
        animation_curve_opacity_fade_in = ${curve "enter"}
        animation_duration_close = ${duration "exit"}
        animation_curve_close = ${curve "exit"}
        animation_curve_opacity_fade_out = ${curve "exit"}
        animation_duration_move = ${duration "move"}
        animation_curve_move = ${curve "move"}
        animation_duration_tag = ${duration "move"}
        animation_curve_tag = ${curve "move"}
        animation_duration_focus = ${duration "effect"}
        animation_curve_focus = ${curve "effect"}

        dim_enable = 1
        dim_focused_color = 0x00000000
        dim_unfocused_color = ${role "background" theme.windows.dimAlpha}

        group_bar_button_color = ${role "critical" "ff"}
        ${decorate "jump_label" (theme.font.size + 2)}
        ${decorate "group_bar" theme.font.size}
        ${decorate "tab_bar" theme.font.size}
        ${decorate "title_message_bar" theme.font.size}
      '';
    in
    {
      config = lib.mkIf (cfg.enable && cfg.mango.enable) {
        xdg.configFile."mango/theme.toml".source = pkgs.runCommand "mango-theme.toml" { } ''
          cp ${themeToml} $out
          ${lib.getExe' cfg.mango.package "mango"} -c $out -p
        '';
      };
    };
}
